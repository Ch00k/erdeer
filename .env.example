# Server
PORT=3001
HOST=127.0.0.1
BASE_URL=http://localhost:7000

# Database
DATABASE_PATH=data/db.sqlite

# OAuth providers (configure at least one)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Dev login: a local-only "Dev login" button that signs in as a fixed user
# without OAuth. Active only when NODE_ENV is not "production" and both values
# below are non-empty. Never set these in production.
DEV_CLIENT_ID=
DEV_CLIENT_SECRET=
